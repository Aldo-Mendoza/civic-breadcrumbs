# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false

# Auth0 SPA/API settings (public identifiers only; no client secret is used)
AUTH0_DOMAIN=your-tenant.ca.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://api.civic-breadcrumbs.example

# Application-owned authorization and abuse limits
GUEST_SESSION_TTL_SECONDS=604800
GUEST_MAX_ACTIVE_JOURNEYS=1
USER_MAX_ACTIVE_JOURNEYS=5
GUEST_AI_DAILY_LIMIT=5
USER_AI_DAILY_LIMIT=30
GUEST_AI_REQUESTS_PER_MINUTE=2
USER_AI_REQUESTS_PER_MINUTE=6
GLOBAL_AI_DAILY_LIMIT=500
AI_RESULT_CACHE_SECONDS=900

# Optional Gemini integration. Never commit a real key.
AI_ENABLED=false
OFFICIAL_SOURCE_FETCH_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
